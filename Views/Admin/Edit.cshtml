@model MilkStore.Models.Product
<form asp-action="Edit" enctype="multipart/form-data" method="post">
    <input asp-for="ProductId" type="hidden" />
    <div class="adminform-group">
        <label>Product Name</label>
        <input asp-for="ProductName" class="form-control" />
    </div>
    <div class="adminform-group">
        <label>Price</label>
        <input asp-for="Price" class="form-control" />
    </div>
    <div class="adminform-group">
        <label>Stock Quantity</label>
        <input asp-for="StockQuantity" class="form-control" />
    </div>
    <div class="adminform-group">
        <label>Category</label>
        <input asp-for="Category" class="form-control" />
    </div>
    <div class="adminform-group">
        <label>Product Image</label>
        <input asp-for="ProductImage" type="file" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success" onclick="return confirmSubmit()">Save Changes</button>
    <button type="button" class="btn btn-danger" onclick="location.href='@Url.Action("Index","Product")'">Cancel</button>

    </form>
<script>
    function confirmSubmit() {
        // Show a confirmation dialog box
        return confirm("Are you sure you want to edit this product?");
    }
</script>

