@model MilkStore.Models.Product
@{
    ViewData["Title"] = "Products";
    var actionType = ViewBag.ActionType as string;
}
<form method="post" asp-action="@(actionType)" class="form-container">
    @if (actionType == "Edit" || actionType == "Delete")
    {
        <div class="form-group">
            <label asp-for="ProductId">Product ID</label>
            <input asp-for="ProductId" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="ProductName">Product Name</label>
            <input asp-for="ProductName" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Category">Category</label>
            <input asp-for="Category" class="form-control" />
        </div>
    }

    @if (actionType != "Delete")
    {
        <div class="form-group">
            <label asp-for="ProductName">Product Name</label>
            <input asp-for="ProductName" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Price">Price</label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" />
        </div>
        <div class="form-group">
            <label asp-for="StockQuantity">Stock Quantity</label>
            <input asp-for="StockQuantity" class="form-control" type="number" />
        </div>
        <div class="form-group">
            <label asp-for="Category">Category</label>
            <input asp-for="Category" class="form-control" />
        </div>
    }

    <button type="submit" class="custom-submit-button">@actionType Product</button>
</form>

