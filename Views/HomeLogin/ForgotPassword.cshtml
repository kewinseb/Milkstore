@model MilkStore.Models.User

@{
    Layout = null;
}
<link rel="stylesheet" href="~/css/ForgotPassword.css">

@using (Html.BeginForm("ForgotPassword", "HomeLogin", FormMethod.Post))
{
    <h2>Forgot Password</h2>
    @Html.AntiForgeryToken()
    <div>
        @Html.LabelFor(m => m.Password)
        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter New Password" })
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
    </div>

    <div>
        @Html.LabelFor(m => m.Password)
        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Confirm Password" })
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Update Password</button>
    @* <div>
        <a href="@Url.Action("Login", "Users")">Back to Login</a>
    </div> *@

}

