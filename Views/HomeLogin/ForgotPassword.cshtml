@model MilkStore.Models.User

@{
    Layout = null;
}
<link rel="stylesheet" href="~/css/ForgotPassword.css">

@using (Html.BeginForm("ForgotPassword", "HomeLogin", FormMethod.Post))
{
    <h2>Forgot Password</h2>
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label>Email Address <span style="color: red;">*</span></label>
        @Html.TextBoxFor(m => m.EmailId, new { @class = "form-control", type = "email", placeholder = "Enter your email" })
        @Html.ValidationMessageFor(m => m.EmailId, null, new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label>New Password <span style="color: red;">*</span></label>
        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter New Password" })
        @Html.ValidationMessageFor(m => m.Password, null, new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label>Confirm Password <span style="color: red;">*</span></label>
        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter Confirm Password" })
        @Html.ValidationMessageFor(m => m.Password, null, new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Update Password</button>
}
