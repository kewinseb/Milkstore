@section Scripts {
    <script src="~/js/order-actions.js"></script>


    <script>
        // Search Button Click Event
        document.getElementById('searchButton').addEventListener('click', function () {
            let orderNoSearch = document.getElementById('orderNoSearch').value.toLowerCase();
            let orderDateSearch = document.getElementById('orderDateSearch').value;
            let tableRows = document.querySelectorAll('#ordersTable tbody tr');

            tableRows.forEach(function(row) {
                let orderNo = row.cells[0].innerText.toLowerCase();
                let orderDate = row.cells[1].innerText; // Assuming the 2nd column is Order Date.

                // Check if both the order number and date match
                let matchOrderNo = orderNo.includes(orderNoSearch);
                let matchOrderDate = orderDate.includes(orderDateSearch);

                // Show or hide the row based on the search criteria
                if (matchOrderNo && matchOrderDate) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    </script>

