@model IEnumerable<MilkStore.Models.Order>

@section Styles {
    <link rel="stylesheet" href="~/css/OrderDetails.css" />
}

<section class="order_section">
    <h2>Order History</h2>
    <div class="felx">
        <div>Order No:</div>
        <div>
            <input type="text" placeholder="Search by Order No" id="orderNoSearch">
        </div>

        <div>Order Date:</div>
        <div>
            <input type="date" id="orderDateSearch">
        </div>
        <div>
            <button id="searchButton" class="searchbut">Search</button>
        </div>
    </div>




<table border="1" cellpadding="5" cellspacing="0" style="width: 100%; text-align: left;">
    <thead>
        <tr>
            <th>Order Id</th>
            <th>User Email</th>
            <th>Total Amount</th>
            <th>Payment Method</th>
            <th>Tracking Number</th>
            <th>Created At</th>
            <th>Order Details</th>
            <th>Shipment Details</th>

           

        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderId</td>
                <td>@order.UserEmailId</td>
                <td>@order.TotalAmount</td>
                <td>@order.PaymentMethod</td>
                <td>@order.TrackingNumber</td>
                <td>@order.CreatedAt</td>
              <td><a class="viewbut" asp-controller="OrderDetails" asp-action="Index">View Details</a></td>
              <td><a class="viewbut" asp-controller="ShipmentDetails" asp-action="Index">Shipment Details</a></td>
            </tr>
        }
    </tbody>
</table>

    
</section>
