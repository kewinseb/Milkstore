@model IEnumerable<MilkStore.Models.Order>

@section Styles {
    <link rel="stylesheet" href="~/css/Order.css" />
}

<section>
    <h2>Order History</h2>
    <div class="felx">
        <div>Order No:</div>
        <div>
            <input type="text" placeholder="Search by Order No" id="orderNoSearch">
        </div>

        <div>Order Date:</div>
        <div>
            <input type="date" id="orderDateSearch">
        </div>
        <div>
            <button id="searchButton" class="searchbut">Search</button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <p>No orders available at the moment.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Order Number</th>
                    <th>Order Total Amount</th>
                    <th>User Email</th>
                    <th>Payment Method</th>
                    <th>Order Details</th>
                    <th>Shipping Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.OrderId</td>
                        <td>@order.TotalAmount</td>
                        <td>@order.UserEmailId</td>
                        <td>@order.PaymentMethod</td>
                        <td><button class="viewbut">View Detailes</button></td>
                        <td><button class="viewbut">Shipping Detailes</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@section Scripts {
    <script src="~/js/order-actions.js"></script>
}
