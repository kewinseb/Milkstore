@model IEnumerable<MilkStore.Models.Order>

@section Styles {
    <link rel="stylesheet" href="~/css/Order.css" />
}

<section>
    <h2>Order History</h2>

    <!-- Search Filters -->
    <div class="search-filters">
        <div class="search-item">
            <label for="orderNoSearch">
                <b>Order No:</b>
            </label>
            <input type="text" id="orderNoSearch" placeholder="Search by Order No">
        </div>
        <div class="search-item">
            <label for="orderDateSearch"><b>Order Date:</b></label>
            <input type="date" id="orderDateSearch">
        </div>
         @* <button id="searchButton" >
             <i class="fa fa-search"></i> <!-- Search Icon -->
         </button> *@
    </div>

    @if (!Model.Any())
    {
        <p>No orders available at the moment.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Order Number</th>
                    <th>Order Total Amount</th>
                    <th>User Email</th>
                    <th>Payment Method</th>
                    <th>Order Details</th>
                    <th>Shipping Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.OrderId</td>
                        <td>@(order.TotalAmount > 0 ? order.TotalAmount.ToString("C") : "N/A")</td>
                        <td>@order.UserEmailId</td>
                        <td>@order.PaymentMethod</td>
                        <td>
                            <a class="view-button" asp-area="" asp-controller="Order" asp-action="Index">Order Details</a>
                            
                        </td>
                        <td>
                            <a class="view-button" asp-area="" asp-controller="ShipmentDetail" asp-action="Index">Shipping Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@section Scripts {
    <script src="~/js/order-actions.js"></script>
}
