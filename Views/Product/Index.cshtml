@model IEnumerable<MilkStore.Models.Product>

@section Styles {
    <link rel="stylesheet" href="~/css/product-listing.css" />
}

<section class="product_section">
    <h2>Product Listing</h2>

    @if (!Model.Any())
    {
        <p>No products available at the moment.</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in Model)
            {
                <div class="product">
                    <!-- Dynamically load image from database -->
                    <img src="@product.ProductImage" alt="@product.ProductName" class="product-image" />
                    <p>@product.ProductName</p>
                    <p class="price">
                        @(product.Price > 0
                            ? string.Format(new System.Globalization.CultureInfo("en-IN"), "₹{0:N2}", product.Price)
                            : "N/A")
                    </p>
                    
                    <div class="actions">
                        <!-- Add to Cart button -->
                        @if (product.StockQuantity > 0)
                        {
                            <button class="add-to-cart" data-product-id="@product.ProductId">Add to Cart</button>
                        }
                        else
                        {
                            <button class="disabled-button" disabled title="Out of Stock">Unavailable</button>
                        }
                        <!-- Admin user Action Buttons -->
                        <button onclick="location.href='@Url.Action("Add", "Admin", new { actionType = "Add", id = product.ProductId })'" class="add_button">Add</button>
                        <button onclick="location.href='@Url.Action("Edit", "Admin", new { actionType = "Edit", id = product.ProductId })'" class="edit_button">Edit</button>
                        <button onclick="location.href='@Url.Action("Delete", "Admin", new { actionType = "Delete", id = product.ProductId })'" class="delete_button">Delete</button>
                        <!-- Quantity controls (hidden by default) -->
                        <div class="quantity-controls hidden" data-product-id="@product.ProductId">
                            <button class="decrement">-</button>
                            <input type="text" class="quantity" value="0" />
                            <button class="increment">+</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

   @section Scripts {
       <script src="~/js/product-actions.js"></script>
   }
