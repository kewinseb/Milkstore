@model IEnumerable<MilkStore.Models.Product>

@section Styles {
    <link rel="stylesheet" href="~/css/product-listing.css" />
}

<section>
    <h2>Product Listing</h2>

    @if (!Model.Any())
    {
        <p>No products available at the moment.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock Quantity</th>
                    <th>Estimated Delivery</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td><img src="@product.productImage" alt="Alternate Text" /></td>
                        <td>@(string.IsNullOrWhiteSpace(product.Category) ? "Uncategorized" : product.Category)</td>
                        <td>@(product.Price > 0 ? product.Price.ToString("C") : "N/A")</td>
                        <td>@(product.StockQuantity > 0 ? product.StockQuantity : "Out of Stock")</td>
                        <td>
                            @product.EstimatedDelivery.ToShortDateString()
                        </td>
                        <td class="actions">
                            @if (product.StockQuantity > 0)
                            {
                                <button class="increment_button" data-product-id="@product.ProductId">+</button>
                                <button class="add_button" data-product-id="@product.ProductId">Add</button>
                                <button class="decrement_button" data-product-id="@product.ProductId">-</button>
                            }
                            else
                            {
                                <button class="disabled-button" disabled title="Out of Stock">Unavailable</button>
                            }

                            <!-- Admin user Action Buttons -->
                            <button onclick="location.href='@Url.Action("Index", "Admin", new { actionType = "Add", id = product.ProductId })'" class="add_button">Add</button>
                            <button onclick="location.href='@Url.Action("Index", "Admin", new { actionType = "Edit", id = product.ProductId })'" class="edit_button">Edit</button>
                            <button onclick="location.href='@Url.Action("Index", "Admin", new { actionType = "Delete", id = product.ProductId })'" class="delete_button">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@section Scripts {
    <script src="~/js/product-actions.js"></script>
}
}
