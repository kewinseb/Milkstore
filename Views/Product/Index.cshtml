@model IEnumerable<MilkStore.Models.Product>

@section Styles {
    <link rel="stylesheet" href="~/css/product-listing.css" />

}

<section class="product_section">
    <h2>Product Listing</h2>

    @if (!Model.Any())
    {
        <p>No products available at the moment.</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in Model)
            {
                <div class="product">
                    <img src="@product.ProductImage" alt="@product.ProductName" class="product-image" />
                    <p>@product.ProductName</p>
                    <p class="price">
                        @(product.Price > 0
                            ? string.Format(new System.Globalization.CultureInfo("en-IN"), "₹{0:N2}", product.Price)
                            : "N/A")
                    </p>

                    <div class="actions">
                        <label for="quantity-@product.ProductId">Quantity</label>
                        <input type="number"
                               id="quantity-@product.ProductId"
                               name="quantity"
                               class="quantity-input"
                               value="1"
                               min="1" />
                        @if (product.StockQuantity > 0)
                        {
                            <button class="add-to-bag" data-product-id="@product.ProductId"
                                    data-product-name="@product.ProductName"
                                    data-product-price="@product.Price"
                                    data-product-image="@product.ProductImage">
                                Add to Bag
                            </button>
                        }
                        else
                        {
                            <button class="disabled-button" disabled title="Out of Stock">Unavailable</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

<!-- Blur Overlay -->
<div class="blur-overlay" id="blurOverlay"></div>

<!-- Sliding Cart -->
<div class="cart-container" id="cartContainer">
    <div class="cart-header">
        <h3>Shopping Bag</h3>
        <button class="close-cart" id="closeCartBtn">×</button> <!-- Close Button in Header -->
    </div>
    <div class="cart-body" id="cartBody"></div>
    <div class="cart-footer">
        <p id="shipping">Shipping: Free</p>
        <p id="total">Total: ₹0.00</p>
        <button class="button button-secondary" onclick="continueShopping()">Continue Shopping</button>
        <button class="button button-primary">Proceed to Checkout</button>
    </div>
</div>
@section Scripts {
    <script src="~/js/product-actions.js"></script>
}

