<header>
    <div class="home_header @(ViewContext.RouteData.Values["controller"] != null && ViewContext.RouteData.Values["controller"].ToString() != "Account" ? "show-cart" : "")">
        <div class="logo">
            <p>Milk Store</p>
        </div>
        <div class="tabs_middle">
            <nav>
                <ul>
                    <li><a class="header_nav" asp-controller="Home" asp-action="Index">Home</a></li>

                    @if (Context.Session.GetString("UserRole") == "admin")
                    {
                        <li class="dropdown">
                            <a class="header_nav dropdown-toggle" href="#" id="adminDropdown">AdminDashboard</a>
                            <ul class="dropdown-menu">
                                <li><a asp-controller="Admin" asp-action="Index">Dashboard</a></li>
                                <li><a asp-controller="Transaction" asp-action="Index">Transaction</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li><a class="header_nav" asp-area="" asp-controller="Product" asp-action="Index">Products</a></li>
                    }

                    <li><a class="header_nav" asp-area="" asp-controller="Orders" asp-action="Index">Orders</a></li>
                    <li><a class="header_nav" asp-controller="ShipmentDetails" asp-action="Index">Shipment</a></li>
                </ul>
            </nav>
        </div>

        <div class="logout">
            <div class="addtocart-container">
                <div class="addtocart" id="cartIcon">
                    <i class="fas fa-cart-shopping"></i>
                </div>
                <div class="circle" id="cart-count">0</div>
            </div>
            <div>
                <button id="logout_button" class="logout_button">
                    <i class="fa-solid fa-user"></i> My Account
                </button>
            </div>
            <button id="logout_button" class="logout_button">
                <i class="fa fa-sign-out" aria-hidden="true"></i> Logout
            </button>
        </div>
    </div>
</header>

<!-- Blur Overlay -->
<div class="blur-overlay" id="blurOverlay"></div>

<!-- Sliding Cart -->
<div class="cart-container" id="cartContainer">
    <div class="cart-header">
        <h3>Shopping Bag</h3>
        <button class="close-cart" id="closeCartBtn">×</button> <!-- Close Button in Header -->
    </div>
    <div class="cart-body" id="cartBody"></div>
    <div class="cart-footer">
        <p id="shipping">Shipping: Free</p>
        <p id="total">Total: ₹0.00</p>
        <button class="button button-secondary" onclick="continueShopping()">Continue Shopping</button>
        <button class="button button-primary">Proceed to Checkout</button>
    </div>
</div>
@section Scripts {
    <script src="~/js/product-actions.js"></script>
}