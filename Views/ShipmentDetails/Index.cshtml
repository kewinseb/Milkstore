<!DOCTYPE html>
<html>
<head>
    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        .container {
            max-width: 800px;
            margin: 20px auto;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
        }

        .customer-option {
            flex: 1;
        }

        .actions {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .action-button {
            padding: 8px 16px;
            background-color: #f5f5f5;
            border: 1px solid #ddd;
            border-radius: 4px;
            cursor: pointer;
        }

        .delivery-tracking {
            margin: 40px 0;
        }

        .status-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 20px 0;
            position: relative;
        }

        .status-line {
            position: absolute;
            height: 2px;
            background-color: #ddd;
            width: 100%;
            top: 50%;
            z-index: 1;
        }

        .progress-line {
            position: absolute;
            height: 2px;
            background-color: #ff9800;
            width: 40%;
            top: 50%;
            z-index: 2;
        }

        .status-point {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background-color: #ddd;
            z-index: 3;
            position: relative;
        }

            .status-point.active {
                background-color: #ff9800;
            }

        .tracking-details {
            margin-top: 30px;
        }

        .tracking-item {
            padding: 10px 0;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
        }

        .status-label {
            color: #ff9800;
            font-weight: bold;
        }

        .dates {
            color: #666;
            font-size: 0.9em;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="customer-option">
                <h3>Customer option</h3>
                <div>Standard</div>
                <div class="dates">
                    Ship by date: Dec 3, 2024 to Dec 4, 2024<br>
                    Deliver by date: Dec 6, 2024 to Dec 11, 2024
                </div>
            </div>
            <div class="actions">
                <button class="action-button">Edit shipment</button>
                <button class="action-button">Print packing slip</button>
                <button class="action-button">Refund Order</button>
                <button class="action-button">Cancel order</button>
            </div>
        </div>

        <div class="delivery-tracking">
            <h3>Delivery Tracking</h3>
            <div class="status-label">In Transit : On Schedule</div>
            <p>Expected delivery:   Thursday 12 December 2024, by 8:00pm</p>

            <div class="status-bar">
                <div class="status-line"></div>
                <div class="progress-line"></div>
                <div class="status-point active"></div>
                <div class="status-point active"></div>
                <div class="status-point"></div>
                <div class="status-point"></div>
                <div class="status-point"></div>
            </div>

            <div class="tracking-details">
                <div class="tracking-item">
                    <div>5 December 2024, 8:05 pm, HYDERABAD WB IN</div>
                    <div>Package arrived at a courier facility</div>
                </div>
                <div class="tracking-item">
                    <div>5 December 2024, 2:34 pm, BANGLORE KA IN</div>
                    <div>Package left the courier facility</div>
                </div>
                <div class="tracking-item">
                    <div>5 December 2024, 12:30 am, CHENNAI KA IN</div>
                    <div>Package arrived at a courier facility</div>
                </div>
                <div class="tracking-item">
                    <div>4 December 2024, 1:30 pm, KOLKATA KA IN</div>
                    <div>Package received by courier</div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>


