@model IEnumerable<MilkStore.Models.ShipmentDetail>

@section Styles {
    <link rel="stylesheet" href="~/css/Shipment.css" />
    
}
    
    <div class="container">
        <div class="header">
            <div class="customer-option">
                <h3>Customer option</h3>
                <div>Standard</div>
                <div class="dates">
                    Ship by date: Dec 3, 2024 to Dec 4, 2024<br>
                    Deliver by date: Dec 6, 2024 to Dec 11, 2024
                </div>
            </div>
            <div class="actions">
                <button id="editShipment" class="action-button">Edit shipment</button>
                <button id="printPackingSlip" class="action-button">Print packing slip</button>
                
            </div>
        </div>

        <div class="delivery-tracking">
            <h3>Delivery Tracking</h3>
            <div class="status-label" id="statusLabel">In Transit : On Schedule</div>
            <p id="expectedDelivery">Expected delivery: Thursday 12 December 2024, by 8:00pm</p>

            <div class="status-bar">
                <div class="status-line"></div>
                <div class="progress-line"></div>
                <div class="status-point" data-stage="Order Placed"></div>
                <div class="status-point" data-stage="Order Processed"></div>
                <div class="status-point" data-stage="Shipped"></div>
                <div class="status-point" data-stage="Out for Delivery"></div>
                <div class="status-point" data-stage="Delivered"></div>
            </div>

            <div class="tracking-details" id="trackingDetails">
                <div class="tracking-item" data-details="Package received by our warehouse team and processing started.">
                    <div>4 December 2024, 1:30 pm, KOLKATA KA IN</div>
                    <div>Package received by courier</div>
                </div>
                <div class="tracking-item" data-details="Package arrived at regional sorting center and being prepared for next route.">
                    <div>5 December 2024, 12:30 am, CHENNAI KA IN</div>
                    <div>Package arrived at a courier facility</div>
                </div>
                <div class="tracking-item" data-details="Package is being transported to the next logistics hub.">
                    <div>5 December 2024, 2:34 pm, BANGLORE KA IN</div>
                    <div>Package left the courier facility</div>
                </div>
                <div class="tracking-item" data-details="Package has arrived at the destination regional facility.">
                    <div>5 December 2024, 8:05 pm, HYDERABAD WB IN</div>
                    <div>Package arrived at a courier facility</div>
                </div>
            </div>
        </div>

        <div class="footer">
            <p>© 2024 Order Tracking. All Rights Reserved.</p>
        </div>
    </div>

    <div id="detailModal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <h2 id="modalTitle">Tracking Details</h2>
            <p id="modalDescription"></p>
        </div>
    </div>

    


