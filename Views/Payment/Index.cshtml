@{
    ViewData["Title"] = "Payment Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="css/payment.css"> <!-- Add your CSS file here -->
</head>

<body>
<div class="payment-container">

    <h1>Payment Page</h1>
    <div class="payment-options">
        <div class="payment-option">
            <input type="radio" name="payment-method" id="debit-credit" value="debit-credit">
            <label for="debit-credit">Debit/Credit Card</label>
        </div>
        <div class="payment-option">
            <input type="radio" name="payment-method" id="cod" value="cod">
            <label for="cod">Cash on Delivery</label>
        </div>
    </div>

    <!-- Forms for each payment method -->
    <div id="debit-credit-form" class="payment-form" style="display: none;">
        <div class="form-group">
            <label for="card-number">Card Number</label>
            <input type="text" id="card-number" placeholder="Enter card number" required>
        </div>
        <div class="form-group">
            <label for="cvv">CVV</label>
            <input type="text" id="cvv" placeholder="Enter CVV" required>
        </div>
    </div>
    <div id="cod-form" class="payment-form" style="display: none;">
        <p>Cash on Delivery selected. Please confirm your order to proceed.</p>
    </div>

    <!-- Form Actions -->
    <div class="form-actions">
        <button class="submit-button" onclick="validateForm()">Submit Payment</button>
        <button class="cancel-button" onclick="cancelPayment()">Cancel</button>
    </div>

    <!-- Error Message -->
    <div id="error-message" class="error-message"></div>
</div>
</body>
</html>

<!-- Include the external payment.js script -->
<script src="js/payment.js"></script>
