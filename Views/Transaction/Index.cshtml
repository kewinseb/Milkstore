@model IEnumerable<MilkStore.Models.Transaction>

<div>
    <h2>Transaction Details</h2>
    <form asp-action="Search" method="post">
        <div style="display: flex; align-items: center; gap: 15px; flex-wrap: wrap;">
            <!-- Transaction ID Field -->
            <div>
                <label for="transactionId">Transaction ID:</label>
                <input type="text" id="transactionId" name="transactionId" />
            </div>

            <!-- From Date Field -->
            <div>
                <label for="fromDate">From Date:</label>
                <input type="date" id="fromDate" name="fromDate" />
            </div>

            <!-- To Date Field -->
            <div>
                <label for="toDate">To Date:</label>
                <input type="date" id="toDate" name="toDate" />
            </div>

            <!-- Buttons -->
            <div>
                <button type="submit">Search</button>
                <button asp-action="Clear" type="submit">Clear</button>
            </div>
        </div>
    </form>

    @if (ViewBag.ErrorMessage != null)
    {
        <p style="color: red">@ViewBag.ErrorMessage</p>
    }

    @if (Model != null && Model.Any())
    {
        <table border="1" cellpadding="5" cellspacing="0" style="margin-top: 20px; width: 100%; text-align: left;">
            <thead>
                <tr>
                    <th>Date & Time</th>
                    <th>Transaction ID</th>
                    <th>Payment Mode</th>
                    <th>Payment Status</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in Model)
                {
                    <tr>
                        <td>@transaction.TransactionDate.ToString("dd-MM-yyyy HH:mm")</td>
                        <td>@transaction.TransactionId</td>
                        <td>@transaction.PaymentMode</td>
                        <td>@transaction.PaymentStatus</td>
                        <td>@transaction.TotalAmountPaid.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p style="margin-top: 20px;">No transactions found.</p>
    }
</div>
